# Copy to .env.local for local use, or set these in your host's dashboard.

# Database. Leave both empty locally and a local.db file is used instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Friends must type this when creating an account. Leave empty to let anyone sign up.
SIGNUP_CODE=

# iCloud link of your shared shortcut. Shown as a "Get the shortcut" button in Settings.
SHORTCUT_URL=
